## Development image. Multi-stage for the same reason the production one is:
## the ~2 GB torch install is the expensive layer, and keeping it in a stage of
## its own means editing source rebuilds only the last few lines.
##
## Python 3.12, not 3.14 — torch has no 3.14 wheels and /ask needs a
## sentence-transformers embedder. See the note in Dockerfile.

FROM python:3.12-slim-bookworm AS builder
WORKDIR /app
COPY requirements-dev.txt requirements.txt requirements-models.txt ./
## The "+cpu" pin is load-bearing — see the note in Dockerfile.
RUN pip install --upgrade pip \
 && pip install --prefix=/install \
      --extra-index-url https://download.pytorch.org/whl/cpu \
      "torch==2.13.0+cpu" -r requirements-dev.txt -r requirements-models.txt

FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
## Outside /app here, unlike the production image: docker-compose bind-mounts the
## repo over /app, so an in-tree cache would drop ~4.4 GB of weights in the checkout.
ENV HF_HOME=/home/appuser/.cache/huggingface
WORKDIR /app

COPY --from=builder /install /usr/local
COPY . .
RUN useradd --create-home --uid 10001 appuser \
 && mkdir -p "$HF_HOME" \
 && chown -R appuser:appuser /app "$HF_HOME"
USER appuser
EXPOSE 8000
## --proxy-headers: see the note in Dockerfile.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", \
     "--proxy-headers", "--forwarded-allow-ips", "*"]
