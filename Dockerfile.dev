## Python 3.12, not 3.14 — torch has no 3.14 wheels and /ask needs a
## sentence-transformers embedder. See the note in Dockerfile.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/app/.cache/huggingface
WORKDIR /app

COPY requirements-dev.txt requirements.txt requirements-models.txt ./
## The "+cpu" pin is load-bearing — see the note in Dockerfile.
RUN pip install --upgrade pip \
 && pip install --extra-index-url https://download.pytorch.org/whl/cpu \
      "torch==2.13.0+cpu" -r requirements-dev.txt -r requirements-models.txt

COPY . .
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
