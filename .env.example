DATABASE_URL=postgresql+asyncpg://rag_user:rag_pass@localhost:5433/rag_db
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=
DAILY_SPEND_CAP_USD=5.0

# Access control. Both defaults below are the open/local setting — see the
# README's "Security posture" table. A Cloud Run deploy does not use this file:
# Terraform generates INGEST_API_KEY into Secret Manager and sets
# ASK_RATE_LIMIT_PER_MINUTE=10 (terraform/secrets.tf, terraform/run.tf).
# Empty leaves POST /ingest unauthenticated; set it to require `x-api-key`.
INGEST_API_KEY=
# Per-client-IP requests per minute on POST /ask; 0 disables the limiter.
ASK_RATE_LIMIT_PER_MINUTE=60
