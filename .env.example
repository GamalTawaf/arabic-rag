DATABASE_URL=postgresql+asyncpg://rag_user:rag_pass@localhost:5433/rag_db
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=
# Hugging Face Inference Providers (OpenAI-compatible router). Set PROVIDERS to
# put it first, or use it alone. Unlike the two above, its rate is not a table in
# the code — HF_PRICE_*_USD_PER_MILLION in app/config.py feeds the spend cap, so
# set them to your account's real rate.
HF_API_KEY=
# PROVIDERS=huggingface
# HF_MODEL=Qwen/Qwen2.5-72B-Instruct
DAILY_SPEND_CAP_USD=5.0

# Access control. Both defaults below are the open/local setting — see the
# README's "Security posture" table. A Cloud Run deploy does not use this file:
# Terraform generates INGEST_API_KEY into Secret Manager and sets
# ASK_RATE_LIMIT_PER_MINUTE=10 (terraform/secrets.tf, terraform/run.tf).
# Empty leaves POST /ingest unauthenticated; set it to require `x-api-key`.
INGEST_API_KEY=
# Per-client-IP requests per minute on POST /ask; 0 disables the limiter.
ASK_RATE_LIMIT_PER_MINUTE=60

# Logging. Plain one-line format locally; LOG_JSON=true emits one JSON object per
# line with the active span's trace_id/span_id on it (app/observability/logs.py).
# GCP_PROJECT additionally emits logging.googleapis.com/trace, which is what makes
# Cloud Logging link a line to its trace — Terraform sets both on Cloud Run.
# LOG_LEVEL=INFO
# LOG_JSON=false
# GCP_PROJECT=
