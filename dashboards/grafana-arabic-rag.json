          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "100 * clamp_min((sum(rate(rag_cache_lookups_total{job=\"arabic-rag\", hit=\"false\", instance=~\"$instance\"}[$__rate_interval])) or vector(0)) - (sum(rate(rag_stage_duration_seconds_count{job=\"arabic-rag\", stage=\"generate\", instance=~\"$instance\"}[$__rate_interval])) or vector(0)), 0) / sum(rate(rag_cache_lookups_total{job=\"arabic-rag\", hit=\"false\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "refused",
          "range": true
        }
      ],
