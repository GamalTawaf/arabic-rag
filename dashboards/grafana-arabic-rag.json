    {
      "id": 4,
      "type": "stat",
      "title": "refusal rate (derived)",
      "description": "NOT a metric the service emits. Derived: a non-cached request either refuses at the rerank floor or reaches generate, and both branches are counted, so refusals = cache misses − generate stages. Exact today; it would need updating if a third non-cached outcome were added before generate. Reads no-data while ANTHROPIC_API_KEY is unset, because a keyless /ask 503s before any of these counters move.",
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 14,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
