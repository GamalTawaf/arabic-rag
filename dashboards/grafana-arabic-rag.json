        "multi": false,
        "skipUrlSync": false
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "description": "prometheus.yml scrapes app:8000 and host.docker.internal:8000 in one job; normally one of the two is down.",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(up{job=\"arabic-rag\"}, instance)",
        "query": {
          "qryType": 1,
          "query": "label_values(up{job=\"arabic-rag\"}, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "allValue": ".*",
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
