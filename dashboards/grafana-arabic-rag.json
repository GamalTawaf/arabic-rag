{
  "uid": "arabic-rag",
  "title": "arabic-rag — cost & latency",
  "description": "Built against the series app/observability/tracing.py actually exports, verified by curling /metrics/ on a running instance: rag_requests_total, rag_stage_duration_seconds, rag_cache_lookups_total, rag_cost_usd_total, gen_ai_client_token_usage_total. Panels that need an LLM API key are marked in their titles.",
  "tags": [
    "arabic-rag",
    "rag",
    "cost",
    "latency"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "links": [
    {
      "title": "Jaeger traces (provider.failover span events live here)",
      "type": "link",
      "icon": "external link",
      "url": "http://localhost:16686/search?service=arabic-rag",
      "targetBlank": true,
      "tooltip": "docker-compose.yml runs Jaeger on :16686",
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "tags": []
    }
  ],
  "templating": {
