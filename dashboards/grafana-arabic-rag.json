    {
      "id": 8,
      "type": "timeseries",
      "title": "mean time per stage (stacked) — where the request goes",
      "description": "Deliberately the MEAN, not p95: it is histogram sum/count, so it is exact rather than bucket-interpolated, and means add up — stacking p95s would be arithmetic that does not hold. Each stage averages over the requests that actually ran it (a cache hit never reaches retrieve or rerank), so the stack is a profile of a typical request, not an exact end-to-end mean. The red line is TOTAL_BUDGET_MS = 3500 ms from benchmark/replay.py, drawn for scale — it is a p95 target, so a mean stack should sit well below it.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "1000 * (sum by (stage) (rate(rag_stage_duration_seconds_sum{job=\"arabic-rag\", instance=~\"$instance\"}[$__rate_interval])) / sum by (stage) (rate(rag_stage_duration_seconds_count{job=\"arabic-rag\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{stage}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
